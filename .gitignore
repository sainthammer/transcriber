# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Downloaded models (several GB, see README)
models/

# User recordings, transcripts and summaries
recordings/

# Recordings (anywhere else in the tree)
*.wav
*.mp3
*.m4a
*.ogg
*.opus
*.flac
*.aac
*.mp4
*.mov
*.webm

# Generated transcripts and summaries
*.txt
*.summary.md
*.summary.json
*.summary.docx
# ...but keep text files that belong to the project
!requirements*.txt
!tests/**/*.txt
# synthetic dev fixtures imported by web/src/dev/mock.ts
!web/src/dev/fixtures/*

# Web UI (web/): dependencies, build output, Playwright screenshots
web/node_modules/
web/dist/
web/.screenshots/
web/test-results/
web/playwright-report/

# macOS
.DS_Store

# Web UI encryption key for stored API keys (when SECRET_KEY isn't set)
instance/

# Tool caches
.pytest_cache/
.ruff_cache/
