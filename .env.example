# Скопируйте в .env и заполните: cp .env.example .env

# Распознавание речи (faster-whisper)
# WHISPER_LANGUAGE=ru   # код языка; auto — определять автоматически
# Папка модели в models/ (или абсолютный путь). Папку faster-whisper-<размер> (small, medium,
# large-v3, large-v3-turbo…) скачивает uv run download-model, а в Docker — сервис models сам
# WHISPER_MODEL=faster-whisper-large-v3-turbo

# DeepSeek API — нужен для summary через DeepSeek (и для auto, если запись не влезает локально)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Локальная модель в Ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_MAX_CONTEXT=32768

# Веб-интерфейс: база (docker compose up -d db) и учётные записи
# DATABASE_URL=postgresql+psycopg://transcriber:transcriber@127.0.0.1:5432/transcriber   # в Docker задаёт compose (хост db)
# Шифрует API-ключи, сохранённые в админке. Без него ключ генерируется в instance/secret_key;
# в Docker он лежит в ./instance (INSTANCE_DIR); потеряете папку — сохранённые ключи не расшифровать.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Первый администратор создаётся при запуске, если пользователей ещё нет
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=           # имя в интерфейсе (по умолчанию — часть email до @)
# COOKIE_SECURE=1   # за HTTPS

# Docker (docker compose up -d --build): эти переменные читает сам compose
# APP_PORT=8000                 # порт на 127.0.0.1
# APP_UID=1000                  # Linux: владелец ./models, ./recordings, ./instance (id -u)
# APP_GID=1000                  # id -g
# APP_MEMORY=4g                 # лимит памяти контейнера (модель ~2 ГБ)
# MODELS_DIR=./models           # где лежат/куда качать модели
# RECORDINGS_DIR=./recordings
# INSTANCE_DIR=./instance
# POSTGRES_USER=transcriber      # учётка Postgres в контейнере db (задаётся до первого запуска)
# POSTGRES_PASSWORD=transcriber
# POSTGRES_DB=transcriber
# Ollama на хосте для контейнера (адрес из админки важнее); OLLAMA_HOST выше — для запуска без Docker
# DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
