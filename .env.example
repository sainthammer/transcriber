# Скопируйте в .env и заполните: cp .env.example .env

# DeepSeek API — нужен для summary через DeepSeek (и для auto, если запись не влезает локально)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Локальная модель в Ollama
# OLLAMA_HOST=http://localhost:11434
